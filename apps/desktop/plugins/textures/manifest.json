{
  "id": "compagesworks.textures",
  "name": "Textures",
  "version": "1.0.0",
  "author": "Tessera",
  "description": "%description%",
  "icon": "image",
  "engines": {
    "tessera": "^0.1.0"
  },
  "permissions": [
    "fs.project.read",
    "fs.project.write",
    "ui.menus",
    { "id": "exec.system", "programs": ["editor"] }
  ],
  "contributes": {
    "host": "host.html",
    "settings": [
      {
        "id": "editorName",
        "type": "string",
        "title": "%editor.name%",
        "description": "%editor.name.description%",
        "default": "Editor",
        "maxLength": 40
      }
    ],
    "widgets": [
      {
        "id": "textures",
        "title": "Textures",
        "description": "%widget.description%",
        "icon": "image",
        "category": "media",
        "entry": "widget.html"
      }
    ],
    "fileActions": [
      {
        "id": "convert",
        "title": "%convert.action%",
        "icon": "arrow-repeat",
        "extensions": [
          "nutexb",
          "bntx",
          "dds",
          "png",
          "jpg",
          "jpeg",
          "webp",
          "gif",
          "bmp",
          "tga",
          "tif",
          "tiff"
        ]
      },
      {
        "id": "edit-external",
        "title": "%editor.action%",
        "icon": "pencil-square",
        "extensions": ["png", "jpg", "jpeg", "webp", "gif", "bmp", "tga", "tif", "tiff", "ico", "dds", "nutexb", "bntx"]
      }
    ]
  }
}
